{
  // Vantage-ARS does NOT deploy to Cloudflare Workers. Deploys target
  // Vercel, Docker, or plain Node (see README "Deploy"). This file exists
  // only so `wrangler` has project context (account id for `wrangler whoami`
  // and Workers AI model defaults) when you manage the Cloudflare side.
  //
  // NEVER put secrets in this file. CLOUDFLARE_API_TOKEN, BETTER_AUTH_SECRET,
  // and FOUNDER_SETUP_TOKEN belong in host environment settings (Vercel
  // project env / Docker .env), never in git. If a token was ever committed
  // here, rotate it immediately (Cloudflare dashboard revoke + new token,
  // then update the host env and redeploy).
  "vars": {
    // Your Cloudflare account id (32 hex chars, Dashboard URL segment).
    // Empty here on purpose: set CLOUDFLARE_ACCOUNT_ID in the host env.
    "CLOUDFLARE_ACCOUNT_ID": "",
    // Workers AI chat model used by the ten AI staff. Override per host
    // with WORKERS_AI_MODEL when Cloudflare publishes a better default.
    "WORKERS_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
  },
}
