# Vantage-ARS — environment
#
# Copy to `.env` for local work (`cp .env.example .env`) or set these as
# environment variables in your host. NOTHING here is required for the site to
# render: with no configuration the office runs on an embedded Postgres in
# memory and simply cannot do anything that reaches the outside world.
#
# The values that matter for a real, self-running office are grouped at the
# bottom under "MAKES THE OFFICE RUN BY ITSELF".

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres. Neon (or any Postgres) when set; embedded PGLite otherwise.
# Migrations run automatically during `npm run build` and on container start.
#   Neon: postgresql://USER:PASSWORD@HOST/db?sslmode=require
DATABASE_URL=
# The same database without PgBouncer (Neon's "unpooled" string). Use it for
# migrations, DDL and long-lived listeners; leave unset when Neon gave none.
DATABASE_URL_UNPOOLED=
# Where the embedded Postgres keeps its files. Unset = in memory, lost on
# restart. Only used when DATABASE_URL is empty.
PGLITE_DATA_DIR=./data
# Per-process pool size. Neon serves many serverless instances; keep this small.
DATABASE_POOL_MAX=4

# ── Authentication ────────────────────────────────────────────────────────────
# The public URL. Used for cookie origin, redirects and reset links.
BETTER_AUTH_URL=https://www.vantage-ars.co.za
# openssl rand -base64 32   — REQUIRED in production. Without it every cold
# start mints a new secret and silently signs the founder out.
BETTER_AUTH_SECRET=
# The one email that opens the office. Defaults to the company address.
FOUNDER_EMAIL=juanlouw.greyling@gmail.com
# One-time code for creating the founder account, 16+ characters. Set it, create
# the account, then REMOVE it and redeploy.
FOUNDER_SETUP_TOKEN=
# Leave unset (or "true") in production. "false" disables sign-in entirely and
# the office will never unlock.
VITE_AUTH_ENABLED=true
# `off` hides the federated sign-in buttons.
GROK_OAUTH=off

# ── Mail ───────────────────────────────────────────────────────────────────────
# Preferred: authenticated implicit-TLS SMTP, port 465. Set SMTP_FROM to an
# address verified by your mail provider; publish that provider's SPF and DKIM
# records before using it. A partial SMTP_* configuration fails closed.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Legacy fallback: Gmail app password. The sender remains the Gmail account.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Optional second delivery path for founder notices. HTTPS only, no embedded
# credentials. Slack and Discord webhook URLs both work; any receiver that
# accepts a JSON body with `text` or `content` will do.
FOUNDER_WEBHOOK_URL=

# ── Bank details ──────────────────────────────────────────────────────────────
# Shown on quotes and invoices. All five or none — an incomplete set is treated
# as "not configured" rather than shown half-filled.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_BRANCH_CODE=
PAYMENT_BENEFICIARY=
PAYMENT_SWIFT=

# ── Online payments (readiness only; no checkout adapter is implemented) ──────
# Keep disabled. Even complete settings do not activate checkout in this build.
# Set credentials only in the host's secret manager, never in client settings.
PAYFAST_CHECKOUT_ENABLED=false
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# ── AI staff reasoning ────────────────────────────────────────────────────────
# Either pair works. With neither set, only the model-driven dispatch panel
# reports unavailable; every autonomous duty still runs, because they decide
# from office records rather than from a language model.
#   Cloudflare Workers AI:  docs/cloudflare-workers-ai.md
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Or xAI:
XAI_API_KEY=
XAI_MODEL=grok-4.5
# Recommended low-cost path: Hugging Face Inference Providers' OpenAI-compatible
# router. Create a fine-grained HF token with Inference Providers permission.
# Free-tier credits/availability are limited and are not an unlimited guarantee;
# if HF is explicitly selected and unavailable, the office stops instead of
# silently switching to a potentially billable provider.
# Set AI_PROVIDER=huggingface to force this path. Leave blank for auto preference.
AI_PROVIDER=
HUGGINGFACE_API_KEY=
HF_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ─────────────────────────────────────────────────────────────────────────────
# MAKES THE OFFICE RUN BY ITSELF
# ─────────────────────────────────────────────────────────────────────────────

# The scheduled autonomous run. With this OFF, `/api/cron/floor` returns 404 and
# nothing happens unless you press "Run the floor". With it ON, the office plans
# and executes its own duties on their own cadences.
AUTONOMY=on

# Bearer token Vercel sends to the cron endpoint. 16+ characters, random.
#   openssl rand -hex 32
CRON_SECRET=